#!/usr/bin/env bash
# Puts up a driver session: `flutter run --profile` of lib/main_driver.dart
# on a device, in the background, and waits until its VM service URL is
# written. tool/drive reads that URL. See docs/DRIVING.md.
#
#   tool/drive-start [-d <device id>]   build, install com.zond.xtremio.debug, run
#   tool/drive-start --stop             end the session (the app stays installed)
#
# The profile build is the debug-suffixed package (android/app/build.gradle.kts),
# so the release install beside it is never touched.
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
dir="${XTREMIO_DRIVE_DIR:-$root/build/drive}"
url_file="$dir/vmservice-url"
pid_file="$dir/flutter-run.pid"
log="$dir/flutter-run.log"
mkdir -p "$dir"

stop() {
  if [ -s "$pid_file" ]; then
    pid="$(cat "$pid_file")"
    # The pipeline below runs in its own process group: end all of it.
    kill -- "-$pid" 2>/dev/null || kill "$pid" 2>/dev/null || true
  fi
  rm -f "$pid_file" "$url_file"
}

device="${XTREMIO_DRIVE_DEVICE:-}"
while [ $# -gt 0 ]; do
  case "$1" in
    --stop) stop; echo "driver session stopped"; exit 0 ;;
    -d) device="$2"; shift 2 ;;
    *) echo "usage: tool/drive-start [-d <device>] | --stop" >&2; exit 64 ;;
  esac
done

stop

version="$(sed -n 's/^version: //p' "$root/pubspec.yaml")"
commit="$(git -C "$root" rev-parse --short HEAD 2>/dev/null || echo unknown)"
[ -z "$(git -C "$root" status --porcelain 2>/dev/null)" ] || commit="$commit-dirty"

# `flutter run` reads commands from stdin and quits at its end, so it is fed
# a stdin that never ends. setsid gives the pipeline a process group of its
# own, which is what --stop ends.
cd "$root"
setsid bash -c '
  tail -f /dev/null | exec flutter run --profile ${1:+-d "$1"} \
    -t lib/main_driver.dart \
    --vmservice-out-file="$2" \
    --dart-define=XTREMIO_VERSION="$3" \
    --dart-define=XTREMIO_GIT_COMMIT="$4"
' drive-start "$device" "$url_file" "$version" "$commit" >"$log" 2>&1 </dev/null &
echo $! >"$pid_file"

echo "building and installing; flutter's output is in $log"
deadline=$((SECONDS + 1800))
until [ -s "$url_file" ]; do
  if ! kill -0 "$(cat "$pid_file")" 2>/dev/null; then
    echo "flutter run ended before the app came up:" >&2
    tail -30 "$log" >&2
    rm -f "$pid_file"
    exit 1
  fi
  if [ $SECONDS -ge $deadline ]; then
    echo "no VM service URL after 30 minutes; see $log" >&2
    exit 1
  fi
  sleep 2
done
echo "driver session up: $(cat "$url_file") (in $url_file)"
