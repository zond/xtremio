<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Network access for addons, the torrent swarm, media streams and the
         loopback stream-server. Flutter's template only declares it in the
         debug/profile manifests, so without this a release APK is offline. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- android:banner is what the Android TV / Google TV home screen shows
         for the app: a 320x180 xhdpi PNG (drawable-xhdpi/banner.png), as the
         leanback launcher wants; the square launcher icon would be letterboxed
         or rejected there. -->
    <!-- usesCleartextTraffic only governs the Java network stack and dart:io
         (Image.network for addon-supplied posters, any Dart call to the
         embedded http://127.0.0.1:<port> server). Rust sockets (reqwest) and
         libmpv are unaffected either way. Self-hosted http:// addons are
         common in the Stremio ecosystem, so plain http is allowed, as in
         the official Stremio Android app. -->
    <application
        android:label="xtremio"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/banner"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
                <!-- Show in the Android TV / Google TV home launcher. -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER"/>
            </intent-filter>
            <!-- stremio:// deep links, which is how every addon site's
                 Install button (stremio-addons.net's included) hands over an
                 addon: it takes the addon's own manifest URL and swaps the
                 scheme, so https://host/manifest.json arrives here as
                 stremio://host/manifest.json. The app opens that addon's
                 details screen; nothing is installed without a press.

                 BROWSABLE is what lets a link in a browser reach the app;
                 DEFAULT is required for an implicit VIEW intent to match.
                 No android:host and no android:autoVerify: the host in these
                 URLs is the addon's own domain, which could be anyone's, so
                 there is no domain to claim and App Links verification (which
                 needs assetlinks.json served from that domain) is impossible
                 by construction. A custom scheme is all this can be, and it
                 is what the official Stremio app registers too.

                 The activity is singleTop, so a link arriving while the app
                 is already up is delivered to the running instance through
                 onNewIntent rather than starting a second one. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="stremio"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <!-- Android TV / Google TV support. The same APK targets phones and TV:
         leanback and touchscreen are declared NOT required so the app is not
         hidden from TV devices (which have no touchscreen) nor from phones. -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
