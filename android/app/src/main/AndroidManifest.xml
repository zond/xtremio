<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Network access for addons, the torrent swarm, media streams and the
         loopback stream-server. Flutter's template only declares it in the
         debug/profile manifests, so without this a release APK is offline. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Foreground services. Two of them, for two unrelated reasons:

         - dataSync is the downloads service (.DownloadsService, declared
           below). Android freezes the process of an app the user has left,
           and the whole download stack (the embedded stream-server and
           librqbit) lives in it, so without this a download only advances
           while the app is on screen. dataSync is the type for "moving
           bytes the user asked for"; the service hosts nothing itself.
         - mediaPlayback is the Google Cast SDK's own media notification,
           run by its MediaNotificationService (declared below); on API 34+
           it needs the matching permission to exist at all.

         The plain FOREGROUND_SERVICE also merges in from
         flutter_chrome_cast's manifest, but this app needs one of its own,
         so it is declared here rather than borrowed. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>

    <!-- API 33+ only, and asked for at runtime the first time a download
         actually starts, never at launch. A refusal costs the progress
         notification and nothing else: the service still runs and downloads
         still finish. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- The Library's Local list: the videos in Android's media index
         (LocalMediaChannel). Asked for when the list is first opened. -->
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO"/>
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED"/>
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"/>
    <!-- Updating the app from its own GitHub release (AppUpdateChannel):
         what lets it open a PackageInstaller session at all. It grants
         nothing by itself: the viewer still allows xtremio under "Install
         unknown apps", and Android confirms every install. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <!-- Voice search on a television (SpeechInput.kt): asked for at the
         first press of the search field's microphone, and the microphone is
         open only from that press to its result. Not required hardware: a
         television with no microphone keeps the keyboard. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-feature android:name="android.hardware.microphone" android:required="false"/>

    <!-- android:banner is what the Android TV / Google TV home screen shows
         for the app: a 320x180 xhdpi PNG (drawable-xhdpi/banner.png), as the
         leanback launcher wants; the square launcher icon would be letterboxed
         or rejected there. -->
    <!-- usesCleartextTraffic only governs the Java network stack and dart:io
         (Image.network for addon-supplied posters, any Dart call to the
         embedded http://127.0.0.1:<port> server). Rust sockets (reqwest) and
         libmpv are unaffected either way. Self-hosted http:// addons are
         common in the Stremio ecosystem, so plain http is allowed, as in
         the official Stremio Android app. -->
    <application
        android:label="${appLabel}"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:banner="@drawable/banner"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
                <!-- Show in the Android TV / Google TV home launcher. -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER"/>
            </intent-filter>
            <!-- stremio:// links, e.g. from an addon site's Install button:
                 opens that addon's details screen; nothing is installed
                 without a press (see docs/DEEP_LINKS.md). BROWSABLE lets a
                 browser link reach the app; DEFAULT is required for an
                 implicit VIEW intent to match. No host and no autoVerify:
                 the host in these URLs is the addon's own domain, so App
                 Links verification is impossible here. singleTop delivers a
                 link arriving while the app is already up through
                 onNewIntent rather than starting a second instance. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="stremio"/>
            </intent-filter>
            <!-- Drive pairing link a television draws as a QR (see
                 docs/ARCHITECTURE.md, "Google Drive"). autoVerify works
                 because this host is ours: Android checks
                 https://xtremio-xervice.web.app/.well-known/assetlinks.json
                 against this package and signing certificate before opening
                 the app, unlike the stremio:// filter above, whose host is
                 the addon author's and so can never verify. A build signed
                 with a different key falls back to the browser instead of
                 breaking. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data
                  android:scheme="https"
                  android:host="xtremio-xervice.web.app"
                  android:path="/link"
                  />
                <data
                  android:scheme="https"
                  android:host="xtremio-xervice.web.app"
                  android:path="/link.html"
                  />
            </intent-filter>
        </activity>
        <!-- The screen a remote types on (TextEntryActivity.kt), opened for
             the `editText` call on the xtremio/device channel and by nothing
             else, which is why it is not exported. Its EditText carries none
             of the IME flags Flutter's fields do, so the Android TV keyboard
             goes fullscreen and owns the D-pad; stateAlwaysVisible is what
             puts it up as the screen appears, with no press to spend on it.
             DeviceDefault so it looks like the rest of the system keyboard
             it shares the screen with. -->
        <activity
            android:name=".TextEntryActivity"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:windowSoftInputMode="stateAlwaysVisible|adjustResize" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- The Google Cast SDK reads its receiver id and launch options from
             an OptionsProvider it instantiates itself, by name, before any
             of our code runs, so it has to be named here and cannot be
             passed in. This is the plugin's own provider, which the plugin
             fills in from the options Dart passes to
             GoogleCastContext.setSharedInstanceWithOptions
             (lib/features/cast/google_cast_client.dart). -->
        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="com.felnanuke.google_cast.GoogleCastOptionsProvider" />

        <!-- Holds the process up while offline downloads are unfinished, with
             the ongoing notification that requires. Started and stopped from
             Dart over the xtremio/downloads channel (DownloadsChannel.kt).
             stopWithTask: a notification nobody can move on or take down is
             worse than none, so the service goes with the Flutter engine
             when the app is swiped from recents (see DownloadsService.kt). -->
        <service
            android:name=".DownloadsService"
            android:exported="false"
            android:stopWithTask="true"
            android:foregroundServiceType="dataSync" />

        <!-- Where a PackageInstaller session reports how an update went
             (AppUpdateChannel.kt). Not exported: only the PendingIntent the
             session was committed with reaches it. -->
        <receiver
            android:name=".InstallStatusReceiver"
            android:exported="false" />

        <!-- The notification the Cast SDK puts up while a session runs, with
             the transport controls on it. It lives in Play services, not in
             this app; declaring it is what lets the SDK start it. -->
        <service
            android:name="com.google.android.gms.cast.framework.media.MediaNotificationService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>

    <!-- Android TV / Google TV support. The same APK targets phones and TV:
         leanback and touchscreen are declared NOT required so the app is not
         hidden from TV devices (which have no touchscreen) nor from phones. -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- The TV search field's microphone recognizes speech in the app
             (SpeechInput.kt). From API 30, SpeechRecognizer.isRecognitionAvailable
             sees a recognition service only when it is declared here. -->
        <intent>
            <action android:name="android.speech.RecognitionService"/>
        </intent>
    </queries>
</manifest>
