{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/node_modules/**",
      "**/.DS_Store",
      "**/.git/**"
    ],
    "rewrites": [
      {
        "source": "/session",
        "function": "api"
      },
      {
        "source": "/session/**",
        "function": "api"
      },
      {
        "source": "/oauth/callback",
        "function": "api"
      },
      {
        "source": "/refresh",
        "function": "api"
      },
      {
        "source": "/probe/**",
        "function": "api"
      }
    ],
    "cleanUrls": true,
    "headers": [
      {
        "source": "/.well-known/assetlinks.json",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=300"
          }
        ]
      },
      {
        "source": "/@(link|pick|index)?(.html)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=60"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs22",
    "ignore": [
      "node_modules",
      ".git",
      "*.log"
    ]
  }
}
